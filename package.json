{
  "name": "music-box-internal",
  "version": "1.0.52",
  "description": "The Music Box — Internal Operations",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "publish": "electron-builder --mac --publish always"
  },
  "build": {
    "appId": "com.themusicboxinc.internal",
    "productName": "Music Box Internal",
    "copyright": "© 2025 The Music Box",
    "mac": {
      "category": "public.app-category.business",
      "icon": "icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "notarize": {
        "teamId": "MULN9RP9V5"
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Music Box Internal",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "index.html",
        "to": "index.html"
      }
    ],
    "asar": true,
    "asarUnpack": [],
    "publish": {
      "provider": "github",
      "owner": "drummerisaiah15-eng",
      "repo": "music-box-internal-releases",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^25.0.0"
  }
}
