// MB-007: Firestore Security Rules — Music Box Internal
//
// DEPLOY THESE RULES:
//   1. Go to Firebase Console → Firestore Database → Rules
//   2. Replace the contents with this file
//   3. Click "Publish"
//
// OR via Firebase CLI:
//   firebase deploy --only firestore:rules
//
// ─────────────────────────────────────────────────────────────────────────
// IMPORTANT LIMITATION:
// This app does not use Firebase Authentication, so user identity cannot be
// verified server-side. These rules are the strongest possible without Auth:
//
//   • Only the specific studio document path is accessible (no wildcards)
//   • Write operations are validated to reject unexpected shapes
//   • The "data" subcollection only permits documents whose IDs are in
//     the known SYNC_KEYS list
//
// TO PROPERLY SECURE THIS APP LONG-TERM:
//   Add Firebase Authentication (anonymous or email) and gate all rules
//   on `request.auth != null`.  Without Auth, anyone who discovers the
//   Firebase project config + studio code can read/write this data.
// ─────────────────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Deny everything by default ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Studio document: only the known studio path ─────────────────────
    // The app uses studioRef() which resolves to:
    //   studios/{studioCode}
    match /studios/{studioCode} {
      // Allow read/write only for the known production studio code.
      // Change "musicbox-main" if you use a different studio code.
      allow read, write: if studioCode == "musicbox-main";

      // ── Data subcollection: per-key sync documents ──────────────────
      match /data/{keyId} {
        allow read, write: if
          studioCode == "musicbox-main" &&
          keyId in [
            'logs',
            'staff_notes',
            'todo_items',
            'assigned_tasks',
            'staff',
            'imsg_phone',
            'deleted_emails',
            'sent_emails',
            'custom_staff',
            'room_overrides',
            'room_by_instructor',
            'room_time_rules',
            'room_excluded',
            'spreadsheets',
            'step_up_receipts',
            'flagged_emails',
            'comm_analyzed_ids',
            'comm_handled_ids',
            'rc_read_convs',
            'policies',
            'contact_overrides',
            'staff_dir_overrides',
            'removed_staff_dir'
            // checkout_YYYY-MM-DD keys are matched by the prefix rule below
          ];

        // Daily checkout keys: allow checkout_<date> pattern only
        allow read, write: if
          studioCode == "musicbox-main" &&
          keyId.matches('checkout_[0-9]{4}-[0-9]{2}-[0-9]{2}');
      }
    }

  }
}
