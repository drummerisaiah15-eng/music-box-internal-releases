// Music Box Internal Firestore rules
//
// Deployment prerequisites:
//   1. Enable Firebase Authentication -> Email/Password.
//   2. Create a dedicated sync user.
//   3. Create musicbox/<studio-code> in the Firebase console with:
//        { memberUids: ["<that user's Firebase UID>"] }
//   4. Deploy these rules before entering credentials in the app.
//   5. Configure and enforce Firebase App Check after verifying the desktop
//      reCAPTCHA provider. Never run this database in test mode.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validStudioDocument(data) {
      return data.keys().hasOnly(['memberUids']) &&
        data.memberUids is list &&
        data.memberUids.size() > 0 &&
        data.memberUids.size() <= 20;
    }

    function isStudioMember(studioCode) {
      return signedIn() &&
        exists(/databases/$(database)/documents/musicbox/$(studioCode)) &&
        validStudioDocument(
          get(/databases/$(database)/documents/musicbox/$(studioCode)).data
        ) &&
        request.auth.uid in
          get(/databases/$(database)/documents/musicbox/$(studioCode)).data.memberUids;
    }

    function baseDataKey(keyId) {
      return keyId in [
        'logs',
        'staff_notes',
        'todo_items',
        'assigned_tasks',
        'staff',
        'deleted_emails',
        'sent_emails',
        'ms_sent_emails',
        'ms_sent_conv_ids',
        'custom_staff',
        'room_overrides',
        'room_by_instructor',
        'room_time_rules',
        'room_excluded',
        'spreadsheets',
        'step_up_receipts',
        'flagged_emails',
        'comm_analyzed_ids',
        'comm_handled_ids',
        'rc_read_convs',
        'policies',
        'staff_dir_overrides',
        'removed_staff_dir'
      ];
    }

    function knownDataKey(keyId) {
      return baseDataKey(keyId) ||
        keyId.matches('checkout_[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    function twoDigit(value) {
      return value < 10 ? '0' + string(value) : string(value);
    }

    function checkoutKeyForDate(at) {
      return 'checkout_' + string(at.year()) + '-' +
        twoDigit(at.month()) + '-' + twoDigit(at.day());
    }

    function writableDataKey(keyId) {
      // Bound daily checkout documents to the app's operational retention
      // window (plus tomorrow for timezone skew). This still lets an offline
      // Mac deliver recent pending work, but a compromised member credential
      // cannot pre-create millions of permanent date-shaped documents.
      return baseDataKey(keyId) ||
        (keyId.matches('checkout_[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
          keyId >= checkoutKeyForDate(request.time - duration.value(45, 'd')) &&
          keyId <= checkoutKeyForDate(request.time + duration.value(1, 'd')));
    }

    function validEncryptedValue(value) {
      return value is map &&
        value.keys().hasOnly(['format', 'keyId', 'ciphertext', 'valueType']) &&
        value.format == 'tmb-sync-aes-gcm-v2' &&
        value.keyId is string &&
        value.keyId.size() >= 16 &&
        value.keyId.size() <= 160 &&
        value.ciphertext is string &&
        value.ciphertext.size() >= 42 &&
        value.ciphertext.size() <= 900000 &&
        value.valueType in ['array', 'object', 'string'];
    }

    function validDataWrite() {
      return request.resource.data.keys().hasOnly([
          'value', 'revision', 'opId', 'writer', 'serverUpdated', 'schemaVersion'
        ]) &&
        validEncryptedValue(request.resource.data.value) &&
        request.resource.data.schemaVersion == 2 &&
        request.resource.data.revision is int &&
        request.resource.data.revision >= 1 &&
        request.resource.data.opId is string &&
        request.resource.data.opId.size() >= 16 &&
        request.resource.data.opId.size() <= 240 &&
        request.resource.data.writer is string &&
        request.resource.data.writer.size() >= 16 &&
        request.resource.data.writer.size() <= 120 &&
        request.resource.data.serverUpdated == request.time;
    }

    function validLegacyData(data) {
      // v1.0.52 used a full-document set with exactly these two fields and an
      // ISO timestamp string. This predicate is intentionally read-only: once
      // upgraded to schema v2 the document can never satisfy it again.
      return data.keys().hasOnly(['value', 'updated']) &&
        data.keys().hasAll(['value', 'updated']) &&
        data.updated is string &&
        data.updated.size() == 24 &&
        data.updated.matches(
          '[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z'
        );
    }

    function validVersionedDataUpdate() {
      return resource.data.schemaVersion == 2 &&
        resource.data.revision is int &&
        resource.data.revision >= 1 &&
        request.resource.data.revision == resource.data.revision + 1;
    }

    function validOneTimeLegacyUpgrade() {
      return validLegacyData(resource.data) &&
        request.resource.data.schemaVersion == 2 &&
        request.resource.data.revision == 1;
    }

    function validMetadataWrite() {
      return request.resource.data.keys().hasOnly([
          'format', 'keyId', 'wrapSalt', 'kdfIterations',
          'wrappedDek', 'keyCheck', 'pinEpoch', 'rotationId', 'updated'
        ]) &&
        request.resource.data.keys().hasAll([
          'format', 'keyId', 'wrapSalt', 'kdfIterations',
          'wrappedDek', 'keyCheck', 'pinEpoch', 'rotationId', 'updated'
        ]) &&
        request.resource.data.format == 'tmb-sync-aes-gcm-v2' &&
        request.resource.data.keyId is string &&
        request.resource.data.keyId.size() >= 16 &&
        request.resource.data.keyId.size() <= 160 &&
        request.resource.data.wrapSalt is string &&
        request.resource.data.wrapSalt.size() >= 20 &&
        request.resource.data.wrapSalt.size() <= 64 &&
        request.resource.data.kdfIterations is int &&
        request.resource.data.kdfIterations >= 600000 &&
        request.resource.data.kdfIterations <= 2000000 &&
        request.resource.data.wrappedDek is string &&
        request.resource.data.wrappedDek.size() >= 80 &&
        request.resource.data.wrappedDek.size() <= 1024 &&
        request.resource.data.keyCheck is string &&
        request.resource.data.keyCheck.size() >= 42 &&
        request.resource.data.keyCheck.size() <= 512 &&
        request.resource.data.pinEpoch is int &&
        request.resource.data.pinEpoch >= 0 &&
        request.resource.data.pinEpoch <= 9007199254740990 &&
        (request.resource.data.rotationId == null ||
          (request.resource.data.rotationId is string &&
            request.resource.data.rotationId.size() >= 16 &&
            request.resource.data.rotationId.size() <= 240)) &&
        request.resource.data.updated == request.time;
    }

    match /musicbox/{studioCode} {
      allow read: if isStudioMember(studioCode);
      // Membership is provisioned only through the Firebase console/Admin SDK.
      allow create, update, delete: if false;

      match /data/{keyId} {
        allow read: if isStudioMember(studioCode) &&
          (knownDataKey(keyId) || keyId == 'sync_metadata');

        allow create: if isStudioMember(studioCode) && (
          (keyId == 'sync_metadata' && validMetadataWrite()) ||
          (writableDataKey(keyId) && validDataWrite() &&
            request.resource.data.revision == 1)
        );

        allow update: if isStudioMember(studioCode) && (
          (keyId == 'sync_metadata' && validMetadataWrite() &&
            request.resource.data.keyId == resource.data.keyId) ||
          (writableDataKey(keyId) && validDataWrite() &&
            (validVersionedDataUpdate() || validOneTimeLegacyUpgrade()))
        );

        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
