.DS_Store
node_modules/
dist/
# Every local build directory, whatever it is called. release.sh refuses to run
# with anything untracked in the tree, and a build left on disk is not a reason
# to be unable to cut a release.
dist-*/
vendor/
*.log

# Working notes and audit handoffs kept alongside the code but not part of it.
# release.sh requires a completely clean worktree including untracked files, so
# these have to be ignored rather than left loose — deleting them is not an
# option, they are the record of what was fixed and why.
TWO_MAC_TEST_SCRIPT.md
CLAUDE_*.md
CODEX_*.md
PENTEST_*.md
HANDOFF.md

# Generated package artifacts
*.asar
*.blockmap
*.dmg
*.zip
latest-mac.yml
